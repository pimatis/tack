{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Capability for the main window",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"window-state:default",
		"opener:default",
		"sql:default",
		"sql:allow-load",
		"sql:allow-select",
		"sql:allow-execute",
		"sql:allow-close",
		"dialog:default",
		"dialog:allow-save",
		"dialog:allow-open",
		"core:window:allow-start-dragging",
		"updater:default",
		"process:default"
	]
}
